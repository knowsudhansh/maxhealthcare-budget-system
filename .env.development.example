APP_ENV=development
APP_BASE_PATH=
PORT=3001
FRONTEND_URL=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
AWS_REGION=
DB_SECRET_ARN=
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=budget_app
DB_USER=<TIDB_USERNAME>
DB_PASSWORD=<TIDB_PASSWORD>
DB_SSL=true
DB_SSL_CA=./certs/tidb-ca.pem
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
LOG_LEVEL=debug
ENABLE_EXCEL_MIRROR=false
ENABLE_GOOGLE_SHEETS_SYNC=false
WORKFLOW_FOUNDATION_ENABLED=true
WORKFLOW_ACTIONS_ENABLED=true
WORKFLOW_LOCK_ENFORCEMENT_ENABLED=false
WORKFLOW_APPROVAL_QUEUE_ENABLED=true
LATEST_ESTIMATE_ENABLED=true
LE_WORKFLOW_ENFORCEMENT_ENABLED=true
LE_ALLOW_LEGACY_BUDGET_SOURCE=false
LE_VARIANCE_WARNING_PERCENT=10
LE_VARIANCE_MATERIAL_PERCENT=20
LE_VARIANCE_WARNING_AMOUNT=100000
LE_VARIANCE_MATERIAL_AMOUNT=500000
NEXT_FY_BUDGET_ENABLED=true
NEXT_FY_WORKFLOW_ENFORCEMENT_ENABLED=true
NEXT_FY_ALLOW_LEGACY_SOURCE=false
NEXT_FY_ALLOW_MANUAL_BASELINE=false
NEXT_FY_ALLOW_GENERATION_RESET=false
NEXT_FY_DEFAULT_GROWTH_PERCENT=0
NEXT_FY_MAX_GROWTH_PERCENT=100
NEXT_FY_MIN_GROWTH_PERCENT=-100
NEXT_FY_MAX_ABSOLUTE_AMOUNT=10000000000
NEXT_FY_MAX_BULK_LINES=500
TRANSFER_MODULE_ENABLED=true
TRANSFER_POSTING_ENABLED=true
TRANSFER_REVERSAL_ENABLED=true

# Authentication and session security
AUTH_SESSION_SECRET=<GENERATE_A_RANDOM_32_PLUS_CHARACTER_SECRET>
AUTH_SESSION_TTL_MINUTES=720
AUTH_IDLE_TIMEOUT_MINUTES=60
AUTH_COOKIE_NAME=max_it_opex_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_TRUST_PROXY=false
CSRF_ENABLED=false
