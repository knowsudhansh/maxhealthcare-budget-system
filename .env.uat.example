APP_ENV=uat
PORT=3001
FRONTEND_URL=https://uat-budget.example.com
ALLOWED_ORIGINS=https://uat-budget.example.com
AWS_REGION=ap-south-1
DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:budget-app-uat-db
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
LOG_LEVEL=info
ENABLE_EXCEL_MIRROR=false
ENABLE_GOOGLE_SHEETS_SYNC=false
