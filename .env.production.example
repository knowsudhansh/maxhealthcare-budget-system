APP_ENV=production
APP_BASE_PATH=/budget-app
PORT=3001
FRONTEND_URL=https://budget.example.com
ALLOWED_ORIGINS=https://budget.example.com
AWS_REGION=ap-south-1
DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:budget-app-production-db
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=true
DB_SSL_CA=./certs/tidb-ca.pem
DB_CONNECTION_LIMIT=20
DB_CONNECT_TIMEOUT_MS=10000
LOG_LEVEL=info
ENABLE_EXCEL_MIRROR=false
ENABLE_GOOGLE_SHEETS_SYNC=false
WORKFLOW_FOUNDATION_ENABLED=true
WORKFLOW_ACTIONS_ENABLED=true
WORKFLOW_LOCK_ENFORCEMENT_ENABLED=false
WORKFLOW_APPROVAL_QUEUE_ENABLED=true
LATEST_ESTIMATE_ENABLED=true
LE_WORKFLOW_ENFORCEMENT_ENABLED=true
LE_ALLOW_LEGACY_BUDGET_SOURCE=false
LE_VARIANCE_WARNING_PERCENT=10
LE_VARIANCE_MATERIAL_PERCENT=20
LE_VARIANCE_WARNING_AMOUNT=100000
LE_VARIANCE_MATERIAL_AMOUNT=500000
